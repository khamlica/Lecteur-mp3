<?xml version="1.0" encoding="utf-8"?>
<!-- Le verre du lecteur de bureau : une teinte sombre, un reflet en biais et un liseré clair -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#C810121C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="315" android:startColor="#24FFFFFF" android:centerColor="#05FFFFFF" android:endColor="#00FFFFFF" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
