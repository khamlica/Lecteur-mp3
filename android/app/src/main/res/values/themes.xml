<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fond de verre : le fond d'écran du téléphone, flouté derrière le lecteur (réglage « Transparence »,
         voir MainActivity.applyTransparency) ; sans lui, un fond sombre plein -->
    <style name="Theme.Hanabi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hanabi_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorAccent">#9cc2ff</item>
    </style>
</resources>
