{
  "name": "hanabi-player",
  "productName": "Hanabi Player",
  "version": "1.0.0",
  "description": "Mini lecteur audio transparent pour Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "npm version patch -m \"Version %s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"Version %s\" && git push --follow-tags"
  },
  "author": "Aymane Khamlichi",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "onnxruntime-node": "^1.30.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^12.2.3"
  },
  "build": {
    "appId": "com.khamlichi.lecteurmp3",
    "productName": "Hanabi Player",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "khamlica",
        "repo": "Lecteur-mp3",
        "private": true,
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Hanabi Player",
      "artifactName": "Hanabi-Player-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
